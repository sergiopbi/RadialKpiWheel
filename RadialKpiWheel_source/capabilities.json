{
    "dataRoles": [
        {
            "displayName": "Values",
            "displayNameKey": "Role_Values",
            "name": "values",
            "kind": "Measure",
            "description": "Drag up to 13 percentage metrics, one per slice. The wheel auto-adjusts to however many are bound. To control the order, rename the field in the well with a leading number, e.g. '1 - Sales', '2 - Margin'.",
            "descriptionKey": "Role_Values_Desc"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                { "values": { "max": 13 } }
            ],
            "categorical": {
                "values": {
                    "select": [
                        { "for": { "in": "values" } }
                    ]
                }
            }
        }
    ],
    "objects": {
